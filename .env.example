# Copy to .env and fill in. Used by docker-compose and local dev.
POSTGRES_USER=opensetlist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opensetlist

# Server
DATABASE_URL=postgres://opensetlist:change-me@localhost:5432/opensetlist
BIND_ADDR=0.0.0.0:8080
# >= 32 bytes, generated per instance in production
SESSION_SECRET=change-me-32-bytes-minimum-dev-only
RUST_LOG=info

# Web (build-time, Vite). Leave EMPTY for same-origin `/api` — both the nginx
# image and the vite dev proxy forward `/api` to the server, so the browser must
# not be pointed at :8080 directly.
PUBLIC_API_BASE_URL=
